---
import { readdirSync } from "node:fs";
import { join } from "node:path";
import Layout from "../layouts/Layout.astro";
import Banner from "../components/ui/Banner.astro";
import { breadcrumb, SITE_URL } from "../lib/business";

// The site's own photos by service, from their folders in public/. On
// aztecahome.com the Worker replaces [data-gallery-slot] with the live
// gallery (these photos plus uploads, with filters and a lightbox); this
// is what GitHub Pages shows on its own.
const sections = [
  { name: "Pest Control", url: "/pest-control", folder: "pest" },
  { name: "Pools", url: "/pools", folder: "pool" },
  { name: "Landscaping", url: "/landscaping", folder: "landscape" },
].map((section) => ({
  ...section,
  photos: readdirSync(join(process.cwd(), "public", section.folder))
    .filter((file) => file.endsWith(".webp"))
    .sort((a, b) => a.localeCompare(b, "en", { numeric: true }))
    .map((file) => `/${section.folder}/${file}`),
}));

const crumbs = breadcrumb([
  { name: "Home", url: `${SITE_URL}/` },
  { name: "Gallery", url: `${SITE_URL}/gallery/` },
]);
---

<Layout
  title="Gallery: Our Work in Phoenix, AZ — AZTECA Home Services"
  description="Photos of AZTECA Home Services pest control, pool service, and landscaping work across the Phoenix valley. Free estimates — call (602) 926-2021."
  ogImage="/og/gallery.jpg"
  jsonLd={crumbs}
>
  <main>
    <section class="container mx-auto p-4">
      <h1 class="py-4 text-4xl font-black uppercase">Gallery</h1>
      <p class="max-w-prose pb-4 text-xl">
        A look at our work around the Phoenix valley: pest control, sparkling
        pools, and well kept yards.
      </p>
      <div data-gallery-slot>
        {sections.map((section) => <section class="py-4">
          <h2 class="py-2 text-3xl font-bold">
            <a class="hover:underline" href={section.url}>
              {section.name}
            </a>
          </h2>
          <ul class="grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-4">
            {section.photos.map((src) => <li>
              <a href={src}>
                <img
                  class="aspect-square w-full rounded-sm object-cover"
                  src={src}
                  alt={`${section.name} photo`}
                  loading="lazy"
                />
              </a>
            </li>)}
          </ul>
        </section>)}
      </div>
    </section>
    <Banner cta="Like what you see? Get a free estimate" verticalSpace />
  </main>
</Layout>
