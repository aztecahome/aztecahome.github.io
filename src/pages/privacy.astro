---
import Layout from "../layouts/Layout.astro";
import { breadcrumb, SITE_URL } from "../lib/business";

const crumbs = breadcrumb([
  { name: "Home", url: `${SITE_URL}/` },
  { name: "Privacy Policy", url: `${SITE_URL}/privacy/` },
]);
---

<Layout
  title="Privacy Policy — AZTECA Home Services"
  description="How AZTECA Home Services handles your information."
  jsonLd={crumbs}
>
  <div
    class="container mx-auto my-12 flex max-w-3xl flex-col gap-6 px-4 text-lg"
  >
    <h1 class="text-3xl font-black uppercase">Privacy Policy</h1>
    <p class="text-base">Last updated October 28, 2026</p>

    <section class="flex flex-col gap-2">
      <h2 class="text-2xl font-bold">Who we are</h2>
      <p>
        AZTECA Home Services provides pest control, landscaping, and pool
        services in the Phoenix, AZ valley. This policy covers aztecahome.com
        and the tools we use to publish to our own social media accounts.
      </p>
    </section>

    <section class="flex flex-col gap-2">
      <h2 class="text-2xl font-bold">Information we collect</h2>
      <p>
        When you call, email, or contact us, we keep the details you give us
        (such as your name, phone number, email, and address) to respond and
        provide our services. We do not sell your information.
      </p>
    </section>

    <section class="flex flex-col gap-2">
      <h2 class="text-2xl font-bold">Social media publishing</h2>
      <p>
        We use an internal scheduling tool, connected through Facebook Login, to
        publish posts to the Facebook Page and Instagram account owned by AZTECA
        Home Services. The tool is used only by our staff. It stores the access
        tokens needed to post to our own accounts and does not collect or store
        information about people who view or interact with our posts.
      </p>
    </section>

    <section class="flex flex-col gap-2">
      <h2 class="text-2xl font-bold">Deleting your data</h2>
      <p>
        To ask us to delete information we hold about you, or data connected
        through Facebook Login, email
        <a class="font-bold underline" href="mailto:support@aztecahome.com"
          >support@aztecahome.com</a
        >
        and we will delete it within 30 days. You can also remove the app's
        access at any time in your Facebook settings under Apps and Websites.
      </p>
    </section>

    <section class="flex flex-col gap-2">
      <h2 class="text-2xl font-bold">Contact</h2>
      <p>
        Questions about this policy: email
        <a class="font-bold underline" href="mailto:support@aztecahome.com"
          >support@aztecahome.com</a
        >
        or call
        <a class="font-bold underline" href="tel:602-926-2021">(602) 926-2021</a
        >.
      </p>
    </section>
  </div>
</Layout>
