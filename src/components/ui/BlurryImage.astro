---
import { Picture } from "astro:assets";
import { FORMATS } from "../../lib/resized.mjs";
import sharp from "sharp";
interface Props {
  alt: string;
  url: string;
  imageMeta: ImageMetadata;
  extraClass?: string;
}
const { alt, url, imageMeta, extraClass } = Astro.props;

// tiny png of ~100 pixels, blown up and blurred while the real image loads
const { width = 1, height = 1 } = await sharp(url).metadata();
const scale = Math.sqrt(100 / (width * height));
const placeholder = await sharp(url)
  .rotate()
  .resize(Math.round(width * scale), Math.round(height * scale))
  .png()
  .toBuffer();
const placeholderURI = `data:image/png;base64,${placeholder.toString("base64")}`;

// The heroes fill a full width section 75vh tall and are cropped to cover it,
// so the photo is as wide as the section or 75vh times its aspect ratio,
// whichever is more.
const sizes = `max(100vw, ${Math.round((75 * imageMeta.width) / imageMeta.height)}vh)`;
---

<div class="image-container">
  <img
    src={placeholderURI}
    alt=""
    class:list={[
      "object-cover object-center w-full h-full absolute blur-lg",
      extraClass,
    ]}
    loading="eager"
  />
  <Picture
    src={imageMeta}
    alt={alt}
    formats={FORMATS.slice(0, -1)}
    fallbackFormat={FORMATS.at(-1)}
    widths={[640, 960, 1280, 1600, 1920, 2560]}
    sizes={sizes}
    pictureAttributes={{ class: "contents" }}
    class:list={[
      "object-cover object-center w-full h-full absolute unblurImg opacity-0 transition-all duration-300 ease-in-out blur-lg",
      extraClass,
    ]}
    loading="eager"
    fetchpriority="high"
  />
</div>

<style>
  .image-container {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    transform: translateZ(1);
  }

  .image-container::before {
    content: "";
    position: absolute;
    inset: 0;
    backdrop-filter: blur(20px);
    transition: backdrop-filter 0.3s ease-in-out;
    z-index: 1;
  }

  .image-container.loaded::before {
    backdrop-filter: blur(0);
  }
</style>

<script>
  // this makes the transition between the preload and the image more seamless
  const myImg = document.querySelector("img.unblurImg");
  const imageContainer = document.querySelector(".image-container");
  if (
    imageContainer &&
    imageContainer instanceof HTMLDivElement &&
    myImg &&
    myImg instanceof HTMLImageElement
  ) {
    if (myImg.complete) {
      imageContainer.classList.add("loaded");
      myImg.classList.remove("blur-lg");
      myImg.classList.remove("opacity-0");
    }
    myImg.onload = () => {
      imageContainer.classList.add("loaded");
      myImg.classList.remove("blur-lg");
      myImg.classList.remove("opacity-0");
    };
  } else {
    alert("WOMP");
    throw new Error("Could not find image to unblur");
  }
</script>
