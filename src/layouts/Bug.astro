---
// Our 6 step process
import type { MarkdownLayoutProps } from "astro";
import Layout from "./Layout.astro";
import Banner from "../components/ui/Banner.astro";
import { service, breadcrumb, SITE_URL } from "../lib/business";
type Props = MarkdownLayoutProps<{
  // Define frontmatter props here
  title: string;
  svg: string;
  bug: string;
  image: string;
  alt: string;
  url: string;
}>;

const { frontmatter, compiledContent } = Astro.props;
import "./Bug.css";

const pageUrl = new URL(Astro.url.pathname, SITE_URL).href;
const svc = service({
  name: frontmatter.title,
  url: pageUrl,
  serviceType: `${frontmatter.bug} Control`,
  description: `Professional ${frontmatter.bug.toLowerCase()} control and mitigation in Phoenix, AZ.`,
  image: `${SITE_URL}${frontmatter.image}`,
});

const crumbs = breadcrumb([
  { name: "Home", url: `${SITE_URL}/` },
  { name: "Pest Control", url: `${SITE_URL}/pest-control/` },
  { name: frontmatter.bug, url: pageUrl },
]);

const slug = Astro.url.pathname.split("/").filter(Boolean).pop();
const metaTitle = `${frontmatter.bug} Control in Phoenix, AZ — AZTECA Home Services`;
const description = `Professional ${frontmatter.bug.toLowerCase()} control and mitigation across the Phoenix valley. Veteran-owned AZTECA Home Services delivers fast, reliable results — call (602) 926-2021.`;
---

<Layout
  title={metaTitle}
  description={description}
  ogImage={`/og/${slug}.jpg`}
  ogType="article"
  jsonLd={[svc, crumbs]}
>
  <div class="container mx-auto mt-14">
    <div class="mx-4 flex items-center justify-between gap-4">
      <div class="rounded bg-army-100 p-4 font-bold">
        <a href="/pest-control" class="underline">/pest-control</a>{
          frontmatter.url.slice(13)
        }
      </div>
      <div
        class="flex h-[56px] w-[56px] shrink-0 items-center justify-center rounded bg-army-200 p-2 transition-colors group-hover:bg-army-400"
      >
        <object
          class="pointer-events-none h-full w-full group-hover:animate-[shake_120ms_linear_infinite]"
          data={`/pest/${frontmatter.svg}`}
          type=""></object>
      </div>
    </div>
    <div class="px-4">
      <h1>{frontmatter.title}</h1>
    </div>
    <div class="mx-4 grid grid-cols-12">
      <div class="col-span-12 md:col-span-8 xl:col-span-6">
        <img
          src={frontmatter.image}
          alt={frontmatter.alt}
          class="max-h-[70vh] rounded-md"
        />
        <div class="my-10">
          <slot />
        </div>
      </div>
    </div>
  </div>
  <Banner cta={`Book ${frontmatter.bug} Control Now`} />
</Layout>
